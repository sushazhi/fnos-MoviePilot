appname               = moviepilot
version               = 3.1.8
display_name          = MoviePilot
desc                  = <b>NAS 媒体库自动化管理工具</b>，支持订阅、搜索、下载、媒体整理与刮削、媒体库刷新及消息通知等核心自动化流程。<br><br>🎬 <b>原生应用：</b>内置 Python 后端与 Web 前端，前后端运行于本地，通过 fnOS 统一网关嵌入桌面访问。

# 系统要求
platform              = all
os_min_version        = 1.1.3104
source                = thirdparty

# 开发者信息
maintainer            = MoviePilot
maintainer_url        = https://github.com/jxxghp/MoviePilot
distributor           = yukihana
distributor_url       = https://github.com/sushazhi/fnos-MoviePilot

# 安装控制
ctl_stop              = true

# JS SDK 支持
micro_app             = true

# 桌面图标配置
desktop_uidir         = ui
desktop_applaunchname = moviepilot.Application

# 依赖运行时
# 不声明 python312：本应用自带 CPython 3.14 运行时（app/python，构建时打包），
# MoviePilot V3 要求 requires-python >= 3.14，fnOS 的 python312 版本不够也用不上。
# 只需要 Node.js 跑前端静态服务。
install_dep_apps      = nodejs_v24

# 更新日志
changelog             = v3.1.8<br>1.上游 MoviePilot v3.1.8 更新内容——优化 Emby、Jellyfin、Plex、Navidrome 查询，按首页展示、媒体查重、入库同步等场景获取所需信息，减少不必要的查询与解析开销；修复自动整理音乐时未同步本地封面的问题，按本地音乐封面设置随音乐文件同步封面；修复 TXT、LRC、Lyricsfile 等歌词文件的权限，遵循部署的 UMASK 设置，避免不同用户运行的媒体服务器无法读取歌词<br>2.上游源码零改动原样集成，仅做 fnOS 打包适配（生命周期脚本、统一网关、桌面入口）<br>3.自带 CPython 3.14.8 运行时与全部依赖，安装时无需联网<br>4.本条目由 GitHub Actions 定时检查上游后自动生成
