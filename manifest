appname               = moviepilot
version               = 3.2.5
display_name          = MoviePilot
desc                  = <b>NAS 媒体库自动化管理工具</b>，支持订阅、搜索、下载、媒体整理与刮削、媒体库刷新及消息通知等核心自动化流程。<br><br>🎬 <b>原生应用：</b>内置 Python 后端与 Web 前端，前后端运行于本地，通过 fnOS 统一网关嵌入桌面访问。

# 系统要求
platform              = all
os_min_version        = 1.1.3104
source                = thirdparty

# 开发者信息
maintainer            = MoviePilot
maintainer_url        = https://github.com/jxxghp/MoviePilot
distributor           = yukihana
distributor_url       = https://github.com/sushazhi/fnos-MoviePilot

# 安装控制
ctl_stop              = true

# JS SDK 支持
micro_app             = true

# 桌面图标配置
desktop_uidir         = ui
desktop_applaunchname = moviepilot.Application

# 依赖运行时
# 不声明 python312：本应用自带 CPython 3.14 运行时（app/python，构建时打包），
# MoviePilot V3 要求 requires-python >= 3.14，fnOS 的 python312 版本不够也用不上。
# 只需要 Node.js 跑前端静态服务。
install_dep_apps      = nodejs_v24

# 更新日志
changelog             = v3.2.5<br>1.上游 MoviePilot v3.2.5 更新内容——以下汇总主项目 v3.2.4 发布后（北京时间 2026 年 11 月 4 日 07:54 起）的前后端及 App 变化；iOS App 采用独立版本号，目前为 v1.2.1；下载与订阅：保留合集中的真实集号，修复缺集被误记为已下载、订阅提前完成的问题；Transmission 临时通信故障支持自动重连重试；整理与网盘：完善远程存储覆盖整理时的临时文件命名，修复 115 等存储的重命名兼容问题<br>2.上游源码零改动原样集成，仅做 fnOS 打包适配（生命周期脚本、统一网关、桌面入口）<br>3.自带 CPython 3.14.8 运行时与全部依赖，安装时无需联网<br>4.本条目由 GitHub Actions 定时检查上游后自动生成
